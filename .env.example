# Peculium release environment (docker-compose.yml).
# Copy this file to `.env` and edit — `.env` is gitignored, never commit it.
# Every entry below is OPTIONAL: with no .env at all the stack boots with
# sensible defaults and auto-generated secrets.

# Image tag for all peculium services. Leave "latest", or pin to a release
# (e.g. vX.Y.Z) to keep the stack on a fixed version across pulls.
# This only selects the image; the version shown inside the app is the one
# baked into the image at build time (an official release, or "develop" for
# a test build).
PECULIUM_VERSION=latest

# Host port the web UI is published on (the backend is only reachable
# through the frontend's /api/ proxy, it exposes no port itself).
PECULIUM_HTTP_PORT=3000

# PostgreSQL password. Leave empty to auto-generate a random one on first
# boot: it is stored in the `peculium_secrets` volume and reused from there
# on every restart (back up that volume to keep the DB password stable).
POSTGRES_PASSWORD=

# JWT signing secret. Leave empty to auto-generate a random one on first
# boot and store it in the `peculium_secrets` volume. Changing/regenerating
# it invalidates all logged-in sessions.
PECULIUM_JWT_SECRET=
