---
import Base from '../../layouts/Base.astro';
import { withBase } from '../../lib/base';
import { UI } from '../../lib/i18n';

const t = UI.it;

/**
 * Aree funzionali dell’app. Slice 3 porterà gli screenshot reali in
 * `public/screenshots/<file>` (capturati dalla stack di test isolata); fino a
 * allora ogni figura mostra il segnaposto. Per collegare uno screenshot,
 * sostituisci il <div> segnaposto con
 * <img src={withBase(`/screenshots/${area.file}`)} ... />.
 */
const areas = [
  {
    file: 'portfolio-dashboard.png',
    title: 'Portfolio e dashboard',
    body: 'Valore totale, utile/perdita e ROI a colpo d’occhio: ciambelle delle allocazioni, grafico a linee delle performance e ROI per asset, aggregati su tutti i portfolio o concentrati su uno solo.',
  },
  {
    file: 'allocations.png',
    title: 'Allocazioni',
    body: 'Ripartizione per classe di asset, area geografica e settore — complessiva o per portfolio, esposizione ETF importata per singola posizione inclusa. Clicca una fetta per aprire il pannello con gli asset che la compongono, o passa qualsiasi grafico alla vista tabella.',
  },
  {
    file: 'transactions.png',
    title: 'Transazioni e storico',
    body: 'Transazioni di acquisto, vendita e dividendi su ogni portfolio, con uno storico attività filtrabile che mantiene ticker e nome dell’asset accanto a ogni riga.',
  },
  {
    file: 'asset-exposure.png',
    title: 'Dettaglio asset ed esposizione',
    body: 'Pagina per asset con metadati modificabili (exchange, ISIN), backfill dello storico prezzi e tabelle di esposizione geografica/settoriale modificabili, accanto ai relativi grafici a ciambella.',
  },
  {
    file: 'price-health.png',
    title: 'Dati e sincronizzazione / stato prezzi',
    body: 'Ricerca per ticker e quotazioni da Yahoo Finance, con aggiornamento su richiesta: il timbro “Prezzi alle” vive nell’header dell’app e gli avvisi sulla qualità dei dati (rate limit, aggiornamenti falliti, tassi di cambio mancanti) ti seguono su ogni pagina.',
  },
  {
    file: 'multi-currency.png',
    title: 'Multi-valuta',
    body: 'Asset quotati in valute diverse vengono aggregati in un’unica vista con l’applicazione dei tassi di cambio, e le posizioni senza tasso vengono segnalate invece di scomparire silenziosamente.',
  },
];
---

<Base
  locale="it"
  path="/it/features"
  title={`${t.navLabel.features} · Peculium`}
  description="Cosa sa fare Peculium: portfolio, transazioni, dati di mercato, performance e allocazione — tutto self-hosted."
>
  <div class="mx-auto max-w-5xl px-4 py-16">
    <h1 class="text-3xl font-extrabold tracking-tight">{t.navLabel.features}</h1>
    <p class="mt-4 max-w-2xl text-lg leading-relaxed text-slate-600 dark:text-slate-300">
      Un tour di ciò che ottieni eseguendo Peculium sul tuo hardware, area per area.
    </p>

    <div class="mt-12 space-y-14">
      {areas.map((area) => (
        <section>
          <h2 class="text-xl font-bold tracking-tight">{area.title}</h2>
          <p class="mt-2 max-w-2xl leading-relaxed text-slate-600 dark:text-slate-300">{area.body}</p>
          <figure class="mt-4">
            {/* Slice 3: sostituisci questo segnaposto con
                <img src={withBase(`/screenshots/${area.file}`)} alt={area.title} width="1280" height="800" class="rounded-xl border border-slate-200 shadow-card dark:border-slate-800" /> */}
            <div
              class="flex aspect-video items-center justify-center rounded-xl border border-dashed border-slate-300 bg-slate-100 text-sm text-slate-400 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-500"
            >
              {t.screenshotSoon}
            </div>
            <figcaption class="mt-2 font-mono text-xs text-slate-400 dark:text-slate-500">
              {withBase(`/screenshots/${area.file}`)}
            </figcaption>
          </figure>
        </section>
      ))}
    </div>
  </div>
</Base>
