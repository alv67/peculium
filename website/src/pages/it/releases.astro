---
import Base from '../../layouts/Base.astro';
import LatestReleaseCard from '../../components/LatestReleaseCard.astro';
import { UI } from '../../lib/i18n';
import { readLatestRelease } from '../../lib/releases';

const t = UI.it;
const release = readLatestRelease();
---

<Base
  locale="it"
  path="/it/releases"
  title={`${t.navLabel.releases} · Peculium`}
  description="Ogni release di Peculium con le note di rilascio per l’utente finale."
>
  <div class="mx-auto max-w-3xl px-4 py-16">
    <h1 class="text-3xl font-extrabold tracking-tight">{t.navLabel.releases}</h1>

    <div class="mt-8 max-w-md">
      <LatestReleaseCard locale="it" {release} />
    </div>

    <p class="mt-4 rounded-lg border border-amber-300 bg-amber-50 px-4 py-3 text-sm text-amber-900 dark:border-amber-700/60 dark:bg-amber-900/20 dark:text-amber-200">
      {t.comingSoon}
    </p>

    <p class="mt-6 leading-relaxed text-slate-600 dark:text-slate-300">
      Questa pagina elencherà ogni versione pubblicata con le note di rilascio complete per
      l’utente finale, generate direttamente dal repository al momento della build: GitHub Releases
      e le note nel repository restano l’unica fonte di verità, senza duplicazioni manuali.
    </p>
  </div>
</Base>
