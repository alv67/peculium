---
import Base from '../layouts/Base.astro';
import { UI } from '../lib/i18n';

const t = UI.en;
---

<Base
  locale="en"
  path="/features"
  title={`${t.navLabel.features} · Peculium`}
  description="What Peculium does: portfolios, transactions, market data, performance and allocation analysis — self-hosted."
>
  <div class="mx-auto max-w-5xl px-4 py-16">
    <h1 class="text-3xl font-extrabold tracking-tight">{t.navLabel.features}</h1>
    <p class="mt-4 max-w-2xl text-lg leading-relaxed text-slate-600 dark:text-slate-300">
      A tour of what you get when you run Peculium on your own hardware.
    </p>

    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {t.features.map((f) => (
        <article class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900">
          <h2 class="font-semibold">{f.title}</h2>
          <p class="mt-2 text-sm leading-relaxed text-slate-600 dark:text-slate-300">{f.body}</p>
        </article>
      ))}
    </div>

    <h2 class="mt-14 text-xl font-bold">Screenshots</h2>
    <div class="mt-4 grid gap-6 sm:grid-cols-3">
      {['Dashboard', 'Portfolio detail', 'Asset exposure'].map((caption) => (
        <figure>
          <div
            class="flex aspect-video items-center justify-center rounded-xl border border-dashed border-slate-300 bg-slate-100 text-sm text-slate-400 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-500"
          >
            {t.screenshotSoon}
          </div>
          <figcaption class="mt-2 text-sm font-medium text-slate-500 dark:text-slate-400">{caption}</figcaption>
        </figure>
      ))}
    </div>
  </div>
</Base>
