---
import Base from '../layouts/Base.astro';
import { withBase } from '../lib/base';
import { UI } from '../lib/i18n';

const t = UI.en;

/**
 * Feature areas of the app. Slice 3 drops the real screenshots into
 * `public/screenshots/<file>` (captured from the isolated test stack); until
 * then each figure renders the "screenshot coming soon" placeholder. To wire
 * a screenshot up, replace the placeholder <div> with
 * <img src={withBase(`/screenshots/${area.file}`)} ... />.
 */
const areas = [
  {
    file: 'portfolio-dashboard.png',
    title: 'Portfolio & dashboard',
    body: 'Total value, gain/loss and ROI at a glance: allocation donuts, a performance line chart and per-asset ROI, aggregated across your portfolios or focused on a single one.',
  },
  {
    file: 'allocations.png',
    title: 'Allocations',
    body: 'Breakdown by asset class, geography and sector — overall or per portfolio, including ETF exposure imported per holding. Click a slice to drill down into the assets behind it, or switch any chart to its table view.',
  },
  {
    file: 'transactions.png',
    title: 'Transactions & history',
    body: 'Buy, sell and dividend transactions on every portfolio, with a filterable activity history that keeps ticker and asset name alongside each entry.',
  },
  {
    file: 'asset-exposure.png',
    title: 'Asset detail & exposure',
    body: 'Per-asset page with editable metadata (exchange, ISIN), price-history backfill and editable geography/sector exposure tables next to their donut charts.',
  },
  {
    file: 'price-health.png',
    title: 'Data & sync / price health',
    body: 'Ticker lookup and quotes from Yahoo Finance with on-demand refresh: the "Prices as of" stamp lives in the app header, and data-quality warnings (rate limits, failed updates, missing FX rates) follow you across pages.',
  },
  {
    file: 'multi-currency.png',
    title: 'Multi-currency',
    body: 'Assets quoted in different currencies are aggregated into a single view with FX rates applied, and holdings missing a rate are flagged instead of silently dropped.',
  },
];
---

<Base
  locale="en"
  path="/features"
  title={`${t.navLabel.features} · Peculium`}
  description="What Peculium does: portfolios, transactions, market data, performance and allocation analysis — self-hosted."
>
  <div class="mx-auto max-w-5xl px-4 py-16">
    <h1 class="text-3xl font-extrabold tracking-tight">{t.navLabel.features}</h1>
    <p class="mt-4 max-w-2xl text-lg leading-relaxed text-slate-600 dark:text-slate-300">
      A tour of what you get when you run Peculium on your own hardware — area by area.
    </p>

    <div class="mt-12 space-y-14">
      {areas.map((area) => (
        <section>
          <h2 class="text-xl font-bold tracking-tight">{area.title}</h2>
          <p class="mt-2 max-w-2xl leading-relaxed text-slate-600 dark:text-slate-300">{area.body}</p>
          <figure class="mt-4">
            {/* Slice 3: replace this placeholder with
                <img src={withBase(`/screenshots/${area.file}`)} alt={area.title} width="1280" height="800" class="rounded-xl border border-slate-200 shadow-card dark:border-slate-800" /> */}
            <div
              class="flex aspect-video items-center justify-center rounded-xl border border-dashed border-slate-300 bg-slate-100 text-sm text-slate-400 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-500"
            >
              {t.screenshotSoon}
            </div>
            <figcaption class="mt-2 font-mono text-xs text-slate-400 dark:text-slate-500">
              {withBase(`/screenshots/${area.file}`)}
            </figcaption>
          </figure>
        </section>
      ))}
    </div>
  </div>
</Base>
