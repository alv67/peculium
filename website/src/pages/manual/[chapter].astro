---
// One route per EN manual chapter (IT mirrors this file under /it/manual).
import ManualLayout from '../../layouts/ManualLayout.astro';
import { getCollection, render } from 'astro:content';
import { UI } from '../../lib/i18n';

export async function getStaticPaths() {
  const chapters = await getCollection('manual', ({ id }) => id.startsWith('en/manual/'));
  return chapters.map((entry) => ({
    params: { chapter: entry.id.split('/').pop()! },
    props: { entry, slug: entry.id.split('/').pop()! },
  }));
}

const { entry, slug } = Astro.props;
const { Content } = await render(entry);
const t = UI.en;
---

<ManualLayout
  locale="en"
  path={`/manual/${slug}`}
  active={slug}
  title={`${entry.data.title} · ${t.navLabel.manual} · ${t.siteName}`}
  description={entry.data.description}
>
  <article class="manual-content">
    <h1>{entry.data.title}</h1>
    <Content />
  </article>
</ManualLayout>
