---
// Manual landing (EN): chapters in order, with their descriptions.
import ManualLayout from '../../layouts/ManualLayout.astro';
import { getCollection } from 'astro:content';
import { withBase } from '../../lib/base';
import { UI } from '../../lib/i18n';

const t = UI.en;
const chapters = (
  await getCollection('manual', ({ id }) => id.startsWith('en/manual/'))
).sort((a, b) => a.data.order - b.data.order);
---

<ManualLayout
  locale="en"
  path="/manual"
  title={`${t.navLabel.manual} · ${t.siteName}`}
  description="The Peculium user manual: quickstart, workflows and settings, written for self-hosted users."
>
  <h1 class="text-3xl font-extrabold tracking-tight">{t.navLabel.manual}</h1>
  <p class="mt-4 max-w-2xl text-lg leading-relaxed text-slate-600 dark:text-slate-300">
    How to run Peculium day to day, from the first login to the dashboard. New
    chapters are added as the manual grows; start with the Quickstart.
  </p>
  <ol class="mt-10 space-y-6">
    {chapters.map((c) => (
      <li>
        <a
          href={withBase(`/manual/${c.id.split('/').pop()}`)}
          class="block rounded-xl border border-slate-200 bg-white p-5 shadow-card transition-colors hover:border-brand dark:border-slate-800 dark:bg-slate-900 dark:hover:border-brand-dark"
        >
          <span class="text-lg font-bold">{c.data.title}</span>
          <span class="mt-1 block text-sm leading-relaxed text-slate-600 dark:text-slate-300">{c.data.description}</span>
        </a>
      </li>
    ))}
  </ol>
</ManualLayout>
